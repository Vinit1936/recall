# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# On Neon, use the TWO connection strings from the dashboard's
# "Connection Details" panel. They are not interchangeable:
#
#   DATABASE_URL -> pooled endpoint (hostname contains "-pooler").
#                   Every runtime query goes through this one.
#   DIRECT_URL   -> direct endpoint. Migrations ONLY, never runtime.
#
# For local Postgres both can point at the same database:
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# Generate with: npx auth secret
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# ---------------------------------------------------------------------------
# OAuth providers (optional for local dev)
# ---------------------------------------------------------------------------
# Callback URLs:
#   Google -> http://localhost:3000/api/auth/callback/google
#   GitHub -> http://localhost:3000/api/auth/callback/github
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Without RESEND_API_KEY, signup OTPs are printed to the dev server console.
RESEND_API_KEY=""
EMAIL_FROM="Recall <noreply@example.com>"

# Raises the GitHub star API rate limit in the sidebar.
GITHUB_TOKEN=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_YANDEX_VERIFICATION=""